---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import CtaPair from '@components/CtaPair.astro';

import { areaNameList } from '@data/business';
import { getService } from '@data/services';
import { brandCategories, brandsByCategory, publishedBrands, type BrandCategory } from '@data/brands';
import { staticPages } from '@data/staticPages';

/**
 * The brands hub.
 *
 * Groups by category and counts from the data — no number is written out in
 * prose, so publishing the next batch of brands does not leave a stale "twenty"
 * somewhere in the copy.
 *
 * No brand logos here or anywhere else on the site. Text only.
 */
const page = staticPages.brands;

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Brands', path: '/brands' },
];

const groups = (Object.keys(brandCategories) as BrandCategory[])
  .map((key) => ({ key, meta: brandCategories[key], entries: brandsByCategory(key) }))
  .filter((group) => group.entries.length > 0);
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  whatsappMessage={page.whatsappMessage}
  breadcrumbs={trail}
>
  <div class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
    <Breadcrumbs trail={trail} />
  </div>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <h1 class="text-3xl leading-tight font-bold tracking-tight text-ink-900 sm:text-4xl">
      {page.h1}
    </h1>

    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-700">
      Most people do not search for "furniture assembly". They search for the thing they
      bought. These pages cover what is actually different about building each one — the
      hardware, the traps, and how long it really takes.
    </p>

    <p class="mt-4 max-w-2xl leading-relaxed text-ink-600">
      I work across {areaNameList} as an independent installer. If your brand is not listed,
      it is almost certainly still work I do — the assembly mechanism is shared within a
      category, so a rower is a rower and a flat-pack wardrobe is a flat-pack wardrobe.
    </p>

    <nav aria-label="Jump to category" class="mt-8 flex flex-wrap gap-2">
      {
        groups.map((group) => (
          <a
            href={`#${group.key}`}
            class="rounded-full bg-ink-100 px-4 py-2 text-sm font-semibold text-ink-700 transition hover:bg-ink-200"
          >
            {group.meta.label}
          </a>
        ))
      }
    </nav>

    <div class="mt-12 space-y-14">
      {
        groups.map((group) => (
          <section id={group.key} class="scroll-mt-40 md:scroll-mt-28" tabindex="-1">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h2 class="text-2xl font-bold tracking-tight text-ink-900">{group.meta.label}</h2>
              <span class="text-sm font-medium text-ink-500">
                {`${group.entries.length} ${group.entries.length === 1 ? 'page' : 'pages'}`}
              </span>
            </div>

            <p class="mt-2 max-w-2xl leading-relaxed text-ink-600">{group.meta.blurb}</p>

            <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {group.entries.map((brand) => {
                const parent = getService(brand.parentServiceSlug);

                return (
                  <li>
                    <a
                      href={`/brands/${brand.slug}`}
                      class="group flex h-full flex-col rounded-xl border border-ink-200 bg-white p-6 transition hover:border-marine-300 hover:shadow-md"
                    >
                      <h3 class="text-lg font-bold text-ink-900 group-hover:text-marine-700">
                        {brand.name}
                      </h3>
                      {parent && (
                        <p class="mt-1 text-xs font-medium tracking-wide text-ink-600 uppercase">
                          {parent.name}
                        </p>
                      )}
                      <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">
                        {brand.seo.description}
                      </p>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="mt-12 max-w-3xl text-xs leading-relaxed text-ink-500">
      All product and company names mentioned on this site are the trademarks of their
      respective owners. {publishedBrands.length === 0 ? '' : 'Aplus Assemblers is an independent assembly service and is not affiliated with, authorized by, or endorsed by any of them.'}
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <CtaPair
      heading="Brand not on the list?"
      body="Tell me what you bought and I will tell you straight away whether it is something I build regularly, and what it costs. Most things are."
      message={page.whatsappMessage}
      placement="page-bottom"
    />
  </section>
</BaseLayout>
