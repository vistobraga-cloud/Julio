---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactButtons from '@components/ContactButtons.astro';

import { publishedServices } from '@data/services';
import { staticPages } from '@data/staticPages';

/**
 * Astro emits this as dist/404.html. Vercel serves that file with a real HTTP
 * 404 for static deployments, so this is a genuine not-found rather than a
 * soft-404 that Google would index as a normal page.
 *
 * noindex is set as well — a 404 body should never be a candidate for the index
 * even if something serves it with a 200 by mistake.
 */
const page = staticPages.notFound;
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  whatsappMessage={page.whatsappMessage}
  noindex={true}
>
  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:py-28">
    <p class="text-sm font-semibold tracking-wide text-marine-700 uppercase">Error 404</p>

    <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">
      {page.h1}
    </h1>

    <p class="mt-5 text-lg leading-relaxed text-ink-700">
      The link was probably mistyped, or a page moved. Nothing is broken on your end.
      Here is everything the site actually has.
    </p>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      <li>
        <a
          href="/services"
          class="block rounded-lg border border-ink-200 bg-white px-4 py-3 font-medium text-ink-800 transition hover:border-marine-300 hover:text-marine-700"
        >
          All services
        </a>
      </li>
      {
        publishedServices.map((service) => (
          <li>
            <a
              href={`/services/${service.slug}`}
              class="block rounded-lg border border-ink-200 bg-white px-4 py-3 font-medium text-ink-800 transition hover:border-marine-300 hover:text-marine-700"
            >
              {service.name}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/about"
          class="block rounded-lg border border-ink-200 bg-white px-4 py-3 font-medium text-ink-800 transition hover:border-marine-300 hover:text-marine-700"
        >
          About Julio
        </a>
      </li>
      <li>
        <a
          href="/contact"
          class="block rounded-lg border border-ink-200 bg-white px-4 py-3 font-medium text-ink-800 transition hover:border-marine-300 hover:text-marine-700"
        >
          Contact
        </a>
      </li>
    </ul>

    <div class="mt-10 border-t border-ink-200 pt-8">
      <p class="font-semibold text-ink-900">
        Or skip the site and just tell me what you need.
      </p>
      <ContactButtons message={page.whatsappMessage} placement="404" class="mt-5" />
    </div>
  </section>
</BaseLayout>
