---
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import ContactButtons from '@components/ContactButtons.astro';
import CtaPair from '@components/CtaPair.astro';
import Faq from '@components/Faq.astro';
import ProofBar from '@components/ProofBar.astro';

import { business, areaNameList } from '@data/business';
import { handyman } from '@data/handyman';
import { publishedServices, getService, type Service } from '@data/services';
import { brandsForService } from '@data/brands';
import { faqPage, service as serviceNode } from '@lib/schema';

/**
 * One page per service category.
 *
 * Only published entries produce a route. An unpublished service is therefore
 * absent from dist/ entirely, which is what keeps it out of the sitemap
 * without a second list to maintain. In `astro dev` everything renders so
 * drafts stay previewable.
 */
export const getStaticPaths: GetStaticPaths = () =>
  publishedServices.map((entry) => ({
    params: { slug: entry.slug },
    props: { service: entry },
  }));

interface Props {
  service: Service;
}

const { service } = Astro.props;

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.name, path: `/services/${service.slug}` },
];

const canonicalPath = `/services/${service.slug}`;
const pageUrl = new URL(canonicalPath, Astro.site ?? business.siteUrl).href;

const schemaNodes = [
  serviceNode({
    name: service.name,
    description: service.seo.description,
    url: pageUrl,
    serviceType: service.name,
  }),
  faqPage(service.faq),
];

// Reciprocity is enforced in src/data/index.ts, so every slug here resolves
// and the page it points at points back.
const relatedServices = service.relatedServiceSlugs
  .map((slug) => getService(slug))
  .filter((entry): entry is Service => entry !== undefined && entry.published);

// Derived from brands.ts rather than listed here, so a new brand links itself
// from this page without anyone editing services.ts.
const brands = brandsForService(service.slug);

const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/placeholders/*.jpg',
  { eager: true },
);
const heroImage = heroImages[`/src/assets/placeholders/${service.slug}.jpg`]?.default;
---

<BaseLayout
  title={service.seo.title}
  description={service.seo.description}
  whatsappMessage={service.whatsappMessage}
  schemaNodes={schemaNodes}
  breadcrumbs={trail}
>
  <div class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
    <Breadcrumbs trail={trail} />
  </div>

  <!-- Opening -->
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <div class="grid gap-10 lg:grid-cols-5 lg:gap-14">
      <div class="lg:col-span-3">
        <h1 class="text-3xl leading-tight font-bold tracking-tight text-ink-900 sm:text-4xl">
          {service.h1}
        </h1>

        <div class="mt-6 space-y-4">
          {service.intro.map((paragraph) => (
            <p class="leading-relaxed text-ink-700">{paragraph}</p>
          ))}
        </div>

        <ContactButtons
          message={service.whatsappMessage}
          placement="service-top"
          class="mt-8"
        />
        <p class="mt-4 text-sm text-ink-500">{business.hoursDisplay}</p>
      </div>

      <div class="lg:col-span-2">
        {
          heroImage && (
            <Picture
              src={heroImage}
              alt={`${service.name} carried out by ${handyman.name}`}
              formats={['avif', 'webp']}
              widths={[400, 600, 800]}
              sizes="(min-width: 1024px) 400px, 100vw"
              fetchpriority="high"
              loading="eager"
              class="w-full rounded-xl object-cover shadow-sm"
            />
          )
        }
      </div>
    </div>
  </section>

  <!-- Subcategories -->
  <section class="border-y border-ink-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">
        What {service.name.toLowerCase()} covers
      </h2>

      <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          service.subcategories.map((sub) => (
            <div>
              <h3 class="font-bold text-ink-900">{sub.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{sub.blurb}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
    <h2 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">How it works</h2>

    <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        service.howItWorks.map((step, index) => (
          <li class="rounded-xl border border-ink-200 bg-white p-6">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
              {index + 1}
            </span>
            <h3 class="mt-4 font-bold text-ink-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Proof + area -->
  <section class="border-y border-ink-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-3 lg:gap-14">
        <div class="lg:col-span-2">
          <ProofBar />
        </div>
        <div>
          <h2 class="text-lg font-bold text-ink-900">Service area</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-600">
            {areaNameList}, from a base in {business.base.locality}, {business.base.region}.
            Southeastern Massachusetts and Rhode Island schedule fastest; everywhere else is
            available, just tell me the town.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Brands under this service -->
  {
    brands.length > 0 && (
      <section class="border-t border-ink-200 bg-white">
        <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
          <h2 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">
            Brands I see most in this category
          </h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-ink-600">
            Each page covers what is actually different about building that one — the
            hardware, the traps and realistic timings.
          </p>

          {
            /* Name only, deliberately. The brand descriptions live on /brands
               and on each brand page; repeating them here made this page and
               the hub 31% identical, which the duplication check caught. */
          }
          <ul class="mt-6 flex flex-wrap gap-3">
            {brands.map((brand) => (
              <li>
                <a
                  href={`/brands/${brand.slug}`}
                  class="inline-block rounded-lg border border-ink-200 bg-paper px-4 py-2.5 font-medium text-ink-800 transition hover:border-marine-300 hover:text-marine-700"
                >
                  {brand.name}
                </a>
              </li>
            ))}
          </ul>

          <a
            href="/brands"
            class="mt-6 inline-block text-sm font-semibold text-marine-700 hover:underline"
          >
            Every brand I assemble →
          </a>
        </div>
      </section>
    )
  }

  <!-- Related services -->
  {
    relatedServices.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <h2 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">
          Often booked with this
        </h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {relatedServices.map((entry) => (
            <a
              href={`/services/${entry.slug}`}
              class="group rounded-xl border border-ink-200 bg-white p-6 transition hover:border-marine-300 hover:shadow-md"
            >
              <h3 class="text-lg font-bold text-ink-900 group-hover:text-marine-700">
                {entry.name}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{entry.seo.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:py-16">
    <Faq items={service.faq} heading={`${service.name}: common questions`} />
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <CtaPair
      heading={`Get a price for ${service.name.toLowerCase()}`}
      body="Send the model, a photo of the box, or just describe the job. You will get a real number and a real window, not a range that moves later."
      message={service.whatsappMessage}
      placement="page-bottom"
    />
  </section>
</BaseLayout>
