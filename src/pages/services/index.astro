---
import { Picture } from 'astro:assets';

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import CtaPair from '@components/CtaPair.astro';

import { areaNameList } from '@data/business';
import { publishedServices } from '@data/services';
import { staticPages } from '@data/staticPages';

/**
 * The services hub.
 *
 * Its job is to route intent and to pass link equity down to the individual service
 * pages, not to rank for the same queries they do — hence a distinct primary
 * keyword and an angle about choosing between them rather than about any one
 * of them.
 */
const page = staticPages.services;

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
];

// Card images live alongside the placeholders, one per slug.
const cardImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/placeholders/*.jpg',
  { eager: true },
);
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  whatsappMessage={page.whatsappMessage}
  breadcrumbs={trail}
>
  <div class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
    <Breadcrumbs trail={trail} />
  </div>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <h1 class="text-3xl leading-tight font-bold tracking-tight text-ink-900 sm:text-4xl">
      {page.h1}
    </h1>

    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-700">
      {publishedServices.length} categories, one person, {areaNameList}. Most jobs fall
      cleanly into one of these. If yours sits across two — trim replaced and then painted,
      or a TV mounted above a cabinet run you also want installed — that is one visit, not
      two bookings.
    </p>

    <p class="mt-4 max-w-2xl leading-relaxed text-ink-600">
      Each page below covers what the work actually involves, what tends to go wrong, and
      how long it really takes. If you already know what you need, the fastest route is
      still a phone call.
    </p>

    <div class="mt-12 space-y-6">
      {
        publishedServices.map((service, index) => {
          const image = cardImages[`/src/assets/placeholders/${service.slug}.jpg`]?.default;

          return (
            <article class="grid gap-6 rounded-xl border border-ink-200 bg-white p-6 sm:grid-cols-3 sm:gap-8 sm:p-8">
              {image && (
                <div class="sm:order-last">
                  <Picture
                    src={image}
                    alt={`${service.name} work by Aplus Assemblers`}
                    formats={['avif', 'webp']}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 640px) 320px, 100vw"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    class="w-full rounded-lg object-cover"
                  />
                </div>
              )}

              <div class="sm:col-span-2">
                <h2 class="text-xl font-bold text-ink-900 sm:text-2xl">
                  <a href={`/services/${service.slug}`} class="hover:text-marine-700">
                    {service.name}
                  </a>
                </h2>

                <p class="mt-3 leading-relaxed text-ink-700">{service.intro[0]}</p>

                <ul class="mt-4 flex flex-wrap gap-2">
                  {service.subcategories.slice(0, 5).map((sub) => (
                    <li class="rounded-full bg-ink-100 px-3 py-1 text-xs font-medium text-ink-700">
                      {sub.name}
                    </li>
                  ))}
                  {service.subcategories.length > 5 && (
                    <li class="rounded-full bg-ink-100 px-3 py-1 text-xs font-medium text-ink-500">
                      +{service.subcategories.length - 5} more
                    </li>
                  )}
                </ul>

                <a
                  href={`/services/${service.slug}`}
                  class="mt-5 inline-block text-sm font-semibold text-marine-700 hover:underline"
                >
                  {service.name} in detail →
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <CtaPair
      heading="Not sure which one you need?"
      body="Describe the job in a sentence and I will tell you which category it falls into, what it costs and how long it takes. That conversation is free and usually takes two minutes."
      message={page.whatsappMessage}
      placement="page-bottom"
    />
  </section>
</BaseLayout>
