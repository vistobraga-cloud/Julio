---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import BookingFlow from '@components/booking/BookingFlow';

import { business } from '@data/business';
import { staticPages } from '@data/staticPages';
import { CONFIRMATION_PROMISE } from '@data/booking';
import { telHref, phoneDisplay } from '@lib/contact';

/**
 * The scheduler.
 *
 * This is the one page on the site that loads React, via a single client:load
 * island. The other pages ship no framework at all — that is the entire reason
 * the stack is what it is.
 *
 * The <h1> lives here rather than inside the island so it is in the HTML
 * regardless of hydration, and so the "exactly one h1" rule stays enforceable.
 */
const page = staticPages.book;

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Book', path: '/book' },
];
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  whatsappMessage={page.whatsappMessage}
  breadcrumbs={trail}
>
  <div class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
    <Breadcrumbs trail={trail} />
  </div>

  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl leading-tight font-bold tracking-tight text-ink-900 sm:text-4xl">
      {page.h1}
    </h1>

    <p class="mt-5 text-lg leading-relaxed text-ink-700">
      Tell me what you have and when suits you. It takes about a minute, there is no account
      to create, and you will see exactly what gets sent before it goes.
    </p>

    <p class="mt-4 leading-relaxed text-ink-600">
      {business.hoursDisplay} Prefer to just talk? <a
        href={telHref}
        data-cta-placement="book-intro"
        class="font-semibold text-marine-700 hover:underline">Call {phoneDisplay}</a
      >.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-8 sm:px-6">
    <BookingFlow client:load />
  </section>

  <section class="border-t border-ink-200 bg-white">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <h2 class="text-xl font-bold text-ink-900">What happens after you send it</h2>
      <p class="mt-3 leading-relaxed text-ink-700">
        {CONFIRMATION_PROMISE} The slot you pick is a request, not a reservation — I schedule
        my own work, so the confirmation comes from me rather than from software. If the time
        does not work I will offer you the nearest one that does.
      </p>
      <p class="mt-3 leading-relaxed text-ink-700">
        Nothing you type here is stored or sent anywhere on its own. The buttons at the end
        open your own WhatsApp or email with the request already written out.
      </p>
    </div>
  </section>
</BaseLayout>
