---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';

import { business, areaNameList } from '@data/business';
import { staticPages } from '@data/staticPages';
import { telHref, phoneDisplay } from '@lib/contact';

const page = staticPages.terms;
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Terms of Service', path: '/terms' },
];

const updated = 'August 2026';
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  whatsappMessage={page.whatsappMessage}
  breadcrumbs={trail}
>
  <div class="mx-auto max-w-3xl px-4 pt-6 sm:px-6">
    <Breadcrumbs trail={trail} />
  </div>

  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:py-14">
    <h1 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">{page.h1}</h1>
    <p class="mt-3 text-sm text-ink-500">Last updated {updated}</p>

    <div class="mt-8 space-y-8">
      <section>
        <h2 class="text-xl font-bold text-ink-900">Who you are dealing with</h2>
        <p class="mt-3 leading-relaxed text-ink-700">
          {business.name} is operated by Julio Oliveira as a one-person business based in
          {business.base.locality}, {business.base.region}, working across {areaNameList}.
          These terms apply to work booked with us.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink-900">Quotes</h2>
        <p class="mt-3 leading-relaxed text-ink-700">
          Quotes are based on the information you provide — the product, the location, and
          the access. They hold for 30 days. If the job on the day differs materially from
          what was described, we will tell you the revised price before continuing rather
          than adding it afterwards. You are free to stop at that point.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink-900">Scheduling and cancellation</h2>
        <p class="mt-3 leading-relaxed text-ink-700">
          Requested times are confirmed personally, usually within a couple of hours.
          Please give as much notice as you can if you need to cancel or move an
          appointment. Repeated same-day cancellations may mean we ask for confirmation
          before holding future slots. If we have to move your appointment, you will hear
          about it as early as possible.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink-900">Site conditions and access</h2>
        <p class="mt-3 leading-relaxed text-ink-700">
          Please make sure there is safe, clear access to the work area, and that someone
          over 18 can let us in. Items should be on site before the appointment. If a
          delivery has not arrived or the space is not accessible, we may have to
          reschedule.
        </p>
        <p class="mt-3 leading-relaxed text-ink-700">
          Where work involves drilling into walls, we locate framing and services as
          carefully as the wall allows. Concealed pipework, wiring or ducting that is not
          detectable by normal means and was not disclosed remains the property owner's
          responsibility. Tell us about anything unusual behind a wall before we start.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink-900">Parts, products and warranties</h2>
        <p class="mt-3 leading-relaxed text-ink-700">
          We assemble and install products supplied by you, following the manufacturer's
          instructions and using the hardware supplied. We are not the manufacturer and do
          not warrant the product itself. Missing, damaged or defective parts in the box
          are a matter between you and the retailer; we will identify exactly what is
          needed and return to finish once it arrives.
        </p>
        <p class="mt-3 leading-relaxed text-ink-700">
          Our own workmanship is guaranteed. If something we assembled or installed comes
          loose, sits wrong or was fitted incorrectly, tell us and we will come back and
          put it right.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink-900">Scope of services</h2>
        <p class="mt-3 leading-relaxed text-ink-700">
          Services are limited to the following: furniture assembly, fitness equipment
          assembly, TV mounting, general handyman work, finish carpentry, custom cabinetry
          installation and painting. Anything outside that list is not covered by these
          terms and would need to be agreed separately in writing.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink-900">Payment</h2>
        <p class="mt-3 leading-relaxed text-ink-700">
          Payment is due on completion, once you have looked over the work. We accept
          {business.paymentAccepted.join(', ')}. Larger jobs may be split into a deposit
          and a balance, agreed in writing beforehand.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink-900">Insurance and liability</h2>
        <p class="mt-3 leading-relaxed text-ink-700">
          We carry insurance. Our liability for any claim arising from work performed is
          limited to the amount paid for that work, except where the law does not allow
          such a limit. Nothing in these terms limits liability for personal injury caused
          by negligence.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink-900">Governing law</h2>
        <p class="mt-3 leading-relaxed text-ink-700">
          These terms are governed by the laws of the Commonwealth of Massachusetts.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink-900">Questions</h2>
        <p class="mt-3 leading-relaxed text-ink-700">
          Anything here that is unclear, ask before you book:
          <a href={telHref} class="font-semibold text-marine-700 hover:underline"
            >{phoneDisplay}</a
          >.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
