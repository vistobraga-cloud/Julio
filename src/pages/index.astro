---
import { Picture } from 'astro:assets';
import heroImage from '@assets/placeholders/hero.jpg';

import BaseLayout from '@layouts/BaseLayout.astro';
import ContactButtons from '@components/ContactButtons.astro';
import CtaPair from '@components/CtaPair.astro';
import ProofBar from '@components/ProofBar.astro';
import Faq from '@components/Faq.astro';
import Icon from '@components/icons/Icon.astro';

import { business, areaNameList, areaAbbrList } from '@data/business';
import { handyman } from '@data/handyman';
import { publishedServices } from '@data/services';
import { staticPages } from '@data/staticPages';
import { faqPage } from '@lib/schema';
import type { Faq as FaqItem } from '@data/services';

const page = staticPages.home;

/**
 * Home-level FAQ. Deliberately none of these repeat a question from a service
 * page — these are the "should I hire this guy at all" questions, not the
 * "how do you mount on brick" questions.
 */
const faqs: FaqItem[] = [
  {
    q: 'How do you charge?',
    a: 'Most work is quoted as a flat price for the job once I know what it is, which is why I ask for the product name or a photo of the box up front. Small mixed jobs are booked by the hour in a minimum block. Either way you get the number before I start, not after.',
  },
  {
    q: 'How soon can you come out?',
    a: 'Usually within the same week, and often the next day for straightforward assembly work in southeastern Massachusetts or the Providence area. Message me with what you need and the town you are in and I will tell you the real availability rather than a placeholder.',
  },
  {
    q: 'Do you bring your own tools?',
    a: 'Yes, all of them, including the ones the box quietly assumes you own. Drills, drivers, a hammer drill for masonry, levels, stud finder, and the anchors and fixings for whatever wall type you have. You do not need to supply anything.',
  },
  {
    q: 'Are you insured?',
    a: `Yes. I carry insurance and I am background checked through ${handyman.socialProof.platform}, where I have held Top Pro status since ${handyman.socialProof.topProSince}. If your building or HOA needs a certificate of insurance before I can work on site, ask and I will get it to you.`,
  },
  {
    q: 'Do you cover my town?',
    a: `I work across ${areaNameList} and I am based in ${business.base.locality}, ${business.base.region}. Southeastern Massachusetts and Rhode Island are the quickest to schedule. Further out is still available — tell me the town and I will be honest about timing.`,
  },
];

const schemaNodes = [faqPage(faqs)];
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  whatsappMessage={page.whatsappMessage}
  schemaNodes={schemaNodes}
>
  <!-- Hero -->
  <section class="border-b border-ink-200 bg-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-14 lg:py-20">
      <div>
        <p class="text-sm font-semibold tracking-wide text-marine-700 uppercase">
          {areaAbbrList} · {handyman.yearsInBusiness} years · One person, start to finish
        </p>

        <h1 class="mt-4 text-3xl leading-[1.05] font-extrabold tracking-tight text-ink-900 sm:text-4xl lg:text-5xl">
          {page.h1}
        </h1>

        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-700">
          You bought the thing. It is sitting in a box in the hallway, and the instructions
          are twelve pages of drawings with no words. I build it, mount it or fix it —
          properly, the first time — and the packaging leaves with me.
        </p>

        <ContactButtons
          message={page.whatsappMessage}
          placement="hero"
          class="mt-8"
        />

        <p class="mt-4 text-sm text-ink-500">{business.hoursDisplay}</p>
      </div>

      <div class="lg:justify-self-end">
        <Picture
          src={heroImage}
          alt="Assembled furniture and a mounted television in a finished living room"
          formats={['avif', 'webp']}
          widths={[560, 800, 1200]}
          sizes="(min-width: 1024px) 560px, 100vw"
          fetchpriority="high"
          loading="eager"
          class="w-full rounded-xl object-cover shadow-sm"
        />
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="border-b border-ink-200 bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <ProofBar />
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
    <div class="grid gap-6 lg:grid-cols-5 lg:gap-14">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">
          What I do, and do properly
        </h2>
        <p class="mt-3 leading-relaxed text-ink-700">
          Not a directory of subcontractors. These are the {publishedServices.length}
          categories I have spent ten years on, which is also the honest list of what I
          take on.
        </p>
      </div>

      <div class="lg:col-span-3">
        <ul class="divide-y divide-ink-200 border-t border-ink-200">
          {
            publishedServices.map((service, index) => (
              <li>
                <a
                  href={`/services/${service.slug}`}
                  class="group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-4 gap-y-1 py-5 transition hover:bg-paper sm:grid-cols-[3rem_1fr_auto]"
                >
                  <span class="font-mono text-sm text-ink-300 tabular-nums">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="text-lg font-bold text-ink-900 group-hover:text-marine-700">
                    {service.name}
                  </span>
                  <Icon
                    name="arrowRight"
                    class="row-span-2 hidden self-center text-ink-300 transition group-hover:translate-x-1 group-hover:text-marine-700 sm:block"
                  />
                  <span class="col-start-2 text-sm leading-relaxed text-ink-600">
                    {service.seo.description}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="border-y border-ink-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2 class="text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">
            Why it matters who does it
          </h2>
          <p class="mt-4 leading-relaxed text-ink-700">
            Assembly looks like a commodity until something goes wrong. A dresser that was
            never anchored. A treadmill leveled to its own frame instead of to the floor,
            wearing the belt on one side. A 65-inch television hanging off drywall anchors
            rated for a picture frame.
          </p>
          <p class="mt-4 leading-relaxed text-ink-700">
            None of those are visible on the day. They show up in month three. Ten years
            of doing this is mostly a catalog of which shortcuts come back, and the
            discipline not to take them.
          </p>
        </div>

        <dl class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
          {
            [
              {
                term: 'You deal with me',
                desc: 'No dispatcher, no rotating crew. The person who answers the phone is the person standing in your living room.',
              },
              {
                term: 'A price before I start',
                desc: 'Send the model or a photo of the box. You get a number, not a range that moves once the job is half done.',
              },
              {
                term: 'Built where it lives',
                desc: 'Assembled in the room it belongs in, so nothing has to squeeze back through a doorway afterwards.',
              },
              {
                term: 'The boxes go with me',
                desc: 'Cardboard and foam flattened and removed. You are left with a room you can use that evening.',
              },
            ].map((item, index) => (
              <div class="border-l-2 border-brand-600 pl-4">
                <span class="font-mono text-xs text-ink-400 tabular-nums">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <dt class="mt-1 font-bold text-ink-900">{item.term}</dt>
                <dd class="mt-2 text-sm leading-relaxed text-ink-600">{item.desc}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Area -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
    <div class="grid gap-8 lg:grid-cols-3 lg:gap-12">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">
          Where I work
        </h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-ink-700">
          {areaNameList}. I am based in {business.base.locality} and most of my work is
          within an hour of it — the South Coast, Greater Providence, the South Shore and
          into Bristol and Newport counties. Boston, Worcester and eastern Connecticut are
          regular trips rather than rare ones.
        </p>
        <p class="mt-4 max-w-2xl leading-relaxed text-ink-700">
          If you are further out, ask anyway. I would rather tell you honestly that a
          Tuesday works better than a Friday than turn down a job that is perfectly doable.
        </p>
      </div>

      <ul class="space-y-3 self-start rounded-xl border border-ink-200 bg-white p-6">
        {
          business.areaServed.map((area) => (
            <li class="flex items-center gap-3">
              <span class="inline-flex h-8 w-8 flex-none items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-800">
                {area.abbr}
              </span>
              <span class="font-medium text-ink-800">{area.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-ink-200 bg-white">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:py-20">
      <Faq items={faqs} heading="Before you call" />
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <CtaPair
      heading="Tell me what is in the box"
      body="Send the product name or a photo of the label and I will give you a real price and a real window. Same week most of the time, next day more often than you would expect."
      message={page.whatsappMessage}
      placement="page-bottom"
    />
  </section>
</BaseLayout>
