---
/**
 * Visible breadcrumb trail. The matching BreadcrumbList JSON-LD is emitted by
 * BaseLayout from the same array, so the markup and the page never disagree.
 */
export type Crumb = { name: string; path: string };

interface Props {
  trail: Crumb[];
  class?: string;
}

const { trail, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-500">
    {
      trail.map((crumb, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && (
            <span aria-hidden="true" class="text-ink-300">
              /
            </span>
          )}
          {index === trail.length - 1 ? (
            <span aria-current="page" class="text-ink-700">
              {crumb.name}
            </span>
          ) : (
            <a href={crumb.path} class="transition hover:text-marine-700">
              {crumb.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
