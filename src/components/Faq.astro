---
import type { Faq } from '@data/services';
import Icon from '@components/icons/Icon.astro';

/**
 * FAQ accordion.
 *
 * Built on native <details>, which keeps every answer in the DOM whether the
 * item is open or shut. That is the requirement: Google must be able to read
 * the answer text in the rendered HTML, and the FAQPage JSON-LD must never
 * claim an answer the page does not actually contain.
 *
 * It also means zero JavaScript, keyboard operation for free, and no
 * dependency on a component library.
 */
interface Props {
  items: Faq[];
  heading?: string;
  /** First item open by default gives the block visible content on arrival. */
  openFirst?: boolean;
  class?: string;
}

const { items, heading = 'Common questions', openFirst = true, class: className = '' } =
  Astro.props;
---

<section class={className}>
  <h2 class="text-2xl font-extrabold text-ink-900 sm:text-3xl">{heading}</h2>

  <div class="mt-6 divide-y divide-ink-200 border-y border-ink-200">
    {
      items.map((item, index) => (
        <details class="group" open={openFirst && index === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 text-left font-semibold text-ink-900 marker:content-none hover:text-marine-700">
            <span>{item.q}</span>
            <Icon
              name="chevronDown"
              size={16}
              class="mt-1.5 flex-none text-ink-400 transition-transform duration-200 group-open:rotate-180"
            />
          </summary>
          <p class="pb-5 leading-relaxed text-ink-700">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* Safari still renders the default disclosure triangle without this. */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
