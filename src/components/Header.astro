---
import { Image } from 'astro:assets';
import logo from '@assets/brand/logo.png';
import { business } from '@data/business';
import { telHref, phoneDisplay } from '@lib/contact';
import { primaryNav, isCurrent } from '@lib/nav';
import Icon from '@components/icons/Icon.astro';
import NavDropdown from '@components/NavDropdown.astro';
import { publishedServices } from '@data/services';
import { brandCategories, type BrandCategory } from '@data/brands';

const pathname = Astro.url.pathname;

const serviceItems = publishedServices.map((s) => ({
  label: s.name,
  href: `/services/${s.slug}`,
}));

const brandCategoryItems = (Object.keys(brandCategories) as BrandCategory[]).map((key) => ({
  label: brandCategories[key].label,
  href: `/brands#${key}`,
}));

// Services and Brands become dropdown panels on desktop; About/Book/Contact
// stay plain links. Keep this in sync with src/lib/nav.ts's primaryNav order.
const restNav = primaryNav.filter((item) => item.label !== 'Services' && item.label !== 'Brands');
---

<header class="sticky top-0 z-30 border-b border-ink-900/8 bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex-none" aria-label={`${business.name} home`}>
      <Image
        src={logo}
        alt={`${business.name} logo`}
        width={260}
        height={102}
        densities={[1, 2]}
        loading="eager"
        class="h-11 w-auto sm:h-14"
      />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-8 md:flex">
      <NavDropdown label="Services" href="/services" items={serviceItems} />
      <NavDropdown label="Brands" href="/brands" items={brandCategoryItems} />
      {
        restNav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}
            class="text-sm font-semibold text-ink-700 transition hover:text-brand-600 aria-[current=page]:text-brand-600"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-none items-center gap-2">
      <a
        href="/search"
        aria-label="Search"
        class="hidden items-center justify-center rounded-full p-2.5 text-ink-600 transition hover:bg-ink-900/5 hover:text-ink-900 md:inline-flex"
      >
        <Icon name="search" size={18} />
      </a>

      <a
        href={telHref}
        data-cta-placement="header"
        class="inline-flex min-h-11 flex-none items-center gap-2 rounded-full bg-brand-500 px-4 py-2 text-sm font-extrabold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-400 sm:min-h-0 sm:px-5 sm:py-2.5"
      >
        <Icon name="phone" size={16} />
        <span class="hidden sm:inline">{phoneDisplay}</span>
        <span class="sm:hidden">Call</span>
      </a>
    </div>
  </div>

  <!-- On small screens the nav moves below the logo row rather than into a
       hamburger. Three links do not justify a menu, and a visible link is
       always better than a hidden one. -->
  <nav
    aria-label="Main"
    class="flex items-center gap-6 overflow-x-auto border-t border-ink-900/8 px-4 py-2.5 md:hidden"
  >
    {
      primaryNav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}
          class="whitespace-nowrap text-sm font-semibold text-ink-600 aria-[current=page]:text-brand-600"
        >
          {item.label}
        </a>
      ))
    }
    <a
      href="/search"
      aria-current={isCurrent('/search', pathname) ? 'page' : undefined}
      class="flex flex-none items-center gap-1 whitespace-nowrap text-sm font-semibold text-ink-600 aria-[current=page]:text-brand-600"
    >
      <Icon name="search" size={14} />
      Search
    </a>
  </nav>
</header>
