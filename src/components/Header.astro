---
import { Image } from 'astro:assets';
import logo from '@assets/brand/logo.png';
import { business } from '@data/business';
import { telHref, phoneDisplay } from '@lib/contact';
import { primaryNav, isCurrent } from '@lib/nav';
import Icon from '@components/icons/Icon.astro';

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-30 border-b border-ink-200 bg-paper/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex-none" aria-label={`${business.name} home`}>
      <Image
        src={logo}
        alt={`${business.name} logo`}
        width={196}
        height={77}
        densities={[1, 2]}
        loading="eager"
        class="h-10 w-auto sm:h-12"
      />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-8 md:flex">
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}
            class="text-sm font-semibold text-ink-700 transition hover:text-marine-700 aria-[current=page]:text-marine-700"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={telHref}
      data-cta-placement="header"
      class="inline-flex flex-none items-center gap-2 rounded-lg bg-brand-600 px-3 py-2 text-sm font-bold text-white transition hover:bg-brand-700 sm:px-4 sm:py-2.5"
    >
      <Icon name="phone" size={16} />
      <span class="hidden sm:inline">{phoneDisplay}</span>
      <span class="sm:hidden">Call</span>
    </a>
  </div>

  <!-- On small screens the nav moves below the logo row rather than into a
       hamburger. Three links do not justify a menu, and a visible link is
       always better than a hidden one. -->
  <nav
    aria-label="Main"
    class="flex items-center gap-6 overflow-x-auto border-t border-ink-200/70 px-4 py-2.5 md:hidden"
  >
    {
      primaryNav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}
          class="whitespace-nowrap text-sm font-semibold text-ink-600 aria-[current=page]:text-marine-700"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
