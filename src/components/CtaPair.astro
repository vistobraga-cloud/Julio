---
import { business } from '@data/business';
import ContactButtons from './ContactButtons.astro';

/**
 * The closing CTA band. One per page, at the end, with copy written for that
 * page rather than a single sentence reused site-wide.
 */
interface Props {
  message: string;
  placement: string;
  heading: string;
  body: string;
  class?: string;
}

const { message, placement, heading, body, class: className = '' } = Astro.props;
---

<section
  class={`surface-night overflow-hidden rounded-[1.75rem] px-7 py-12 sm:px-12 sm:py-16 ${className}`}
>
  <h2 class="display display-md max-w-2xl text-white">{heading}</h2>
  <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/65">{body}</p>
  <ContactButtons message={message} placement={placement} tone="dark" class="mt-9" />
  <p class="mt-5 text-sm text-white/45">{business.hoursDisplay}</p>
</section>
