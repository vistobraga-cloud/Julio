---
import { telHref, whatsappHref, phoneDisplay } from '@lib/contact';

/**
 * The dual CTA itself: call first, WhatsApp second.
 *
 * Call leads because a large share of this audience will not have WhatsApp,
 * and a phone call is the shortest path from "I need this today" to a booked
 * job. WhatsApp sits alongside it for everyone who prefers to send a photo of
 * the box rather than describe it.
 *
 * `message` is the page's own prefilled text, so a visitor arriving on TV
 * mounting opens a chat about TV mounting.
 *
 * `placement` rides along into the analytics event, so the reporting can tell
 * a sticky-bar tap apart from a hero click.
 */
interface Props {
  message: string;
  placement: string;
  /** `dark` inverts the secondary button for use on the ink-900 band. */
  tone?: 'light' | 'dark';
  class?: string;
}

const { message, placement, tone = 'light', class: className = '' } = Astro.props;

const secondary =
  tone === 'dark'
    ? 'border-white/35 text-white hover:bg-white hover:text-ink-900'
    : 'border-marine-700 text-marine-700 hover:bg-marine-700 hover:text-white';
---

<div class={`flex flex-col gap-3 sm:flex-row sm:flex-wrap ${className}`}>
  <a
    href={telHref}
    data-cta-placement={placement}
    class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-6 py-3.5 text-base font-semibold text-white shadow-sm transition hover:bg-brand-700 active:bg-brand-800"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"
      ></path>
    </svg>
    Call {phoneDisplay}
  </a>

  <a
    href={whatsappHref(message)}
    data-cta-placement={placement}
    rel="noopener"
    class={`inline-flex items-center justify-center gap-2 rounded-lg border-2 px-6 py-3.5 text-base font-semibold transition ${secondary}`}
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.2 1.3-2 1.4-.5.1-1.2.1-3.9-1-3.3-1.4-5.4-4.7-5.6-4.9-.2-.2-1.3-1.8-1.3-3.4S5.8 6 6.2 5.6c.3-.3.6-.4.8-.4h.6c.2 0 .5 0 .7.5l1 2.4c.1.2.1.4 0 .6l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.4 1.8 2.3 1.2 1.1 2.2 1.4 2.5 1.6.3.1.5.1.6-.1l.9-1c.2-.2.4-.2.6-.1l2.3 1.1c.3.2.5.2.6.4.1.1.1.7-.1 1.4Z"
      ></path>
    </svg>
    WhatsApp
  </a>
</div>
