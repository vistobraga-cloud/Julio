---
import { telHref, whatsappHref, phoneDisplay } from '@lib/contact';
import Icon from '@components/icons/Icon.astro';

/**
 * The dual CTA itself: call first, WhatsApp second.
 *
 * Call leads because a large share of this audience will not have WhatsApp,
 * and a phone call is the shortest path from "I need this today" to a booked
 * job. WhatsApp sits alongside it for everyone who prefers to send a photo of
 * the box rather than describe it.
 *
 * `message` is the page's own prefilled text, so a visitor arriving on TV
 * mounting opens a chat about TV mounting.
 *
 * `placement` rides along into the analytics event, so the reporting can tell
 * a sticky-bar tap apart from a hero click.
 */
interface Props {
  message: string;
  placement: string;
  /** `dark` inverts the secondary button for use on the ink-900 band. */
  tone?: 'light' | 'dark';
  class?: string;
}

const { message, placement, tone = 'light', class: className = '' } = Astro.props;

const secondary =
  tone === 'dark'
    ? 'border-white/35 text-white hover:bg-white hover:text-ink-900'
    : 'border-marine-700 text-marine-700 hover:bg-marine-700 hover:text-white';
---

<div class={`flex flex-col gap-3 sm:flex-row sm:flex-wrap ${className}`}>
  <a
    href={telHref}
    data-cta-placement={placement}
    class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-6 py-3.5 text-base font-bold text-white shadow-sm transition hover:bg-brand-700 active:bg-brand-800"
  >
    <Icon name="phone" />
    Call {phoneDisplay}
  </a>

  <a
    href={whatsappHref(message)}
    data-cta-placement={placement}
    rel="noopener"
    class={`inline-flex items-center justify-center gap-2 rounded-lg border-2 px-6 py-3.5 text-base font-bold transition ${secondary}`}
  >
    <Icon name="whatsapp" />
    WhatsApp
  </a>
</div>
