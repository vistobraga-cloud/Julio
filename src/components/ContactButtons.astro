---
import { telHref, whatsappHref, phoneDisplay } from '@lib/contact';
import Icon from '@components/icons/Icon.astro';

/**
 * The dual CTA itself: call first, WhatsApp second.
 *
 * Call leads because a large share of this audience will not have WhatsApp,
 * and a phone call is the shortest path from "I need this today" to a booked
 * job. WhatsApp sits alongside it for everyone who prefers to send a photo of
 * the box rather than describe it.
 *
 * The secondary button used to be outlined in marine blue, which put a second
 * saturated colour next to the green one and left the pair reading as two
 * equal choices. It is now neutral on light and a translucent white on dark,
 * so green is the only thing on any page that looks like the action.
 *
 * `message` is the page's own prefilled text, so a visitor arriving on TV
 * mounting opens a chat about TV mounting.
 *
 * `placement` rides along into the analytics event, so the reporting can tell
 * a sticky-bar tap apart from a hero click.
 */
interface Props {
  message: string;
  placement: string;
  /** `dark` inverts the secondary button for use on a night surface. */
  tone?: 'light' | 'dark';
  class?: string;
}

const { message, placement, tone = 'light', class: className = '' } = Astro.props;

const secondary =
  tone === 'dark'
    ? 'border-white/25 bg-white/5 text-white hover:border-white/60 hover:bg-white/12'
    : 'border-ink-900/15 bg-white text-ink-900 hover:border-ink-900/40 hover:bg-ink-50';
---

<div class={`flex flex-col gap-3 sm:flex-row sm:flex-wrap ${className}`}>
  <a
    href={telHref}
    data-cta-placement={placement}
    class="group inline-flex items-center justify-center gap-2.5 rounded-full bg-brand-500 px-7 py-4 text-base font-extrabold text-white shadow-lg shadow-brand-900/25 transition duration-200 hover:-translate-y-0.5 hover:bg-brand-400 hover:shadow-xl hover:shadow-brand-900/30 active:translate-y-0"
  >
    <Icon name="phone" />
    Call {phoneDisplay}
  </a>

  <a
    href={whatsappHref(message)}
    data-cta-placement={placement}
    rel="noopener"
    class={`inline-flex items-center justify-center gap-2.5 rounded-full border px-7 py-4 text-base font-bold backdrop-blur-sm transition duration-200 hover:-translate-y-0.5 ${secondary}`}
  >
    <Icon name="whatsapp" />
    WhatsApp a photo
  </a>
</div>
