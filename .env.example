# Copy to .env and fill in. Every value here is optional: the site builds and
# runs with all of them empty. Analytics simply no-ops until the IDs exist.

# Google Analytics 4 measurement ID. Format: G-XXXXXXXXXX
# Leave empty until the property is created — no script is emitted without it.
PUBLIC_GA4_ID=

# Google Search Console HTML meta verification token.
# PREFER DNS TXT VERIFICATION INSTEAD: it verifies the whole domain including
# subdomains and survives any redesign. Use this only if DNS is unavailable.
PUBLIC_GSC_VERIFICATION=

# Public Thumbtack profile URL. Used as the link behind the social-proof line
# and, once set, as the single entry of schema.org sameAs.
# Leave empty rather than guessing — a wrong sameAs is worse than none.
PUBLIC_THUMBTACK_URL=

# Google Business Profile URL. Fill this the moment the GBP is verified —
# it becomes the strongest sameAs signal the site can emit.
PUBLIC_GBP_URL=

# Public review short link (g.page/r/...). Powers the "leave a review" CTA.
PUBLIC_GOOGLE_REVIEW_URL=
